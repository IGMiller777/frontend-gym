    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.58.0",
    "mermaid": "12.2.0",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@bramus/specificity": "^2.4.3",
    "@hono/node-server": "^2.1.5",
    "@ngrx/signals": "22.0.1",
    "@reduxjs/toolkit": "2.14.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-core": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@trpc/client": "11.26.0",
    "@trpc/server": "11.26.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vue/devtools-api": "^8.2.1",
    "concurrently": "^10.0.6",
    "dataloader": "2.2.3",
    "dom-accessibility-api": "^0.7.1",
    "dompurify": "3.4.17",
    "graphql": "17.1.0",
    "hono": "^4.13.13",
    "jotai": "3.0.2",
