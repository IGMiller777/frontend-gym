{
  "name": "frontend-gym",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build-frame.ts && concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch --import tsx server/index.ts\"",
    "dev:web": "tsx scripts/build-frame.ts && vite",
    "build:frame": "tsx scripts/build-frame.ts",
    "dev:api": "node --watch --import tsx server/index.ts",
    "build": "tsx scripts/build-frame.ts && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview --port 5900",
    "test": "vitest run",
    "check:content": "tsx scripts/check-content.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
